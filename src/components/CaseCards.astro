---
import { Quote } from "lucide-react";
import { CASE_STUDIES, TESTIMONIAL } from "@/lib/site";

// English only. `compact` drops the photos (Quote page).
const { lang, compact = false } = Astro.props;
const showTestimonial = TESTIMONIAL.approved || import.meta.env.DEV;
---

<div lang={lang !== "en" ? "en" : undefined} class:list={["grid grid-cols-1 gap-6", showTestimonial ? "lg:grid-cols-3" : "md:grid-cols-2"]}>
  {
    CASE_STUDIES.map((c) => (
      <article class="gt-card flex flex-col" data-testid={`case-${c.key}`}>
        {!compact && (
          <figure class="aspect-[16/9] overflow-hidden border-b border-gray-200 bg-gray-100">
            <img src={c.img} alt={c.alt} loading="lazy" class="w-full h-full object-cover" />
          </figure>
        )}
        <div class="p-7 flex flex-col flex-1">
          <div class="text-xs tracking-[0.18em] uppercase text-red-600 font-bold">{c.sector}</div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900 leading-snug">{c.title}</h3>
          <p class="mt-3 text-[15px] text-gray-600 leading-relaxed flex-1">{c.body}</p>
          <div class="mt-6 pt-5 border-t border-gray-200 grid grid-cols-2 gap-4">
            {c.metrics.map((m) => (
              <div class="border-l-2 border-red-600 pl-3">
                <div class="font-display text-2xl font-bold leading-none text-gray-900">{m.value}</div>
                <div class="mt-1 text-xs uppercase tracking-widest font-semibold text-gray-500">{m.label}</div>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))
  }
  {
    showTestimonial && (
      <figure class="bg-[#0A0A0A] text-white p-8 flex flex-col" data-testid="case-testimonial">
        {!TESTIMONIAL.approved && (
          <div class="mb-4 self-start bg-yellow-300 text-black text-[11px] font-bold uppercase tracking-wider px-2 py-1">
            Draft — replace with an approved customer quote (hidden in production)
          </div>
        )}
        <Quote size={28} className="text-red-500" aria-hidden="true" />
        <blockquote class="mt-5 text-lg leading-relaxed flex-1">&ldquo;{TESTIMONIAL.quote}&rdquo;</blockquote>
        <figcaption class="mt-6 text-sm text-gray-400">
          <span class="text-white font-semibold">{TESTIMONIAL.name}</span> · {TESTIMONIAL.company}
        </figcaption>
        <div class="mt-6 pt-6 border-t border-white/10">
          <div class="border-l-2 border-red-600 pl-3">
            <div class="font-display text-2xl font-bold leading-none text-white">{TESTIMONIAL.metric.value}</div>
            <div class="mt-1 text-xs uppercase tracking-widest font-semibold text-gray-400">{TESTIMONIAL.metric.label}</div>
          </div>
        </div>
      </figure>
    )
  }
</div>
