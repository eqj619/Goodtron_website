---
import CaseCards from "@/components/CaseCards.astro";

// English only.
const { lang } = Astro.props;
---

<section id="case-studies" data-testid="section-case-studies" lang={lang !== "en" ? "en" : undefined} class="border-b border-gray-200 bg-white scroll-mt-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
    <div class="max-w-3xl mb-14">
      <div class="text-sm md:text-[15px] tracking-widest text-red-600 uppercase font-bold mb-4">Case Studies</div>
      <h2 class="font-display text-4xl lg:text-5xl tracking-tight font-semibold text-gray-900 leading-[1.1]">
        Real builds. Measured results.
      </h2>
      <p class="mt-5 text-lg text-gray-600 leading-relaxed">
        How hardware teams use Goodtron for fast prototypes and complex SMT — in their numbers.
      </p>
    </div>
    <CaseCards lang={lang} />
  </div>
</section>
