---
import { localePath } from "@/i18n/core";

const { lang } = Astro.props;
---

<a href={localePath(lang, "/")} data-testid="brand-logo" class="flex items-center gap-3 select-none" aria-label="Goodtron Electronics">
  <img src="/assets/logo-mark.png?v=6" alt="" aria-hidden="true" draggable="false" class="h-11 w-auto" />
  <span class="font-display leading-none flex items-baseline gap-2">
    <span class="font-bold tracking-tight text-xl lg:text-[22px]" style="color: #DC2626">GOODTRON</span>
    <span class="text-gray-900 text-[11px] lg:text-xs font-semibold tracking-[0.18em] uppercase">Electronics</span>
  </span>
</a>
