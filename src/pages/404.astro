---
import Base from "@/layouts/Base.astro";
---

<Base lang="en" path="/404" title="Page not found" noPrefRedirect>
  <div data-testid="page-notfound" class="max-w-3xl mx-auto px-6 py-32 text-center">
    <div class="overline mb-6">404</div>
    <h1 class="font-display text-5xl font-semibold text-gray-900">Page not found.</h1>
    <p class="mt-4 text-gray-600">The page you're looking for doesn't exist.</p>
    <a href="/" class="btn-primary mt-10 inline-flex" data-testid="notfound-home">Back to Home</a>
  </div>
</Base>
