---
import { ArrowUpRight, Mail, Phone, MapPin, Clock } from "lucide-react";
import Base from "@/layouts/Base.astro";
import RfqIsland from "@/islands/RfqIsland.jsx";
import { SITE } from "@/lib/site";
import { getI18n, localeStaticPaths, langFromParams } from "@/i18n/core";

export const getStaticPaths = localeStaticPaths;

const lang = langFromParams(Astro.params);
const { t, href } = getI18n(lang);

const overline = "text-sm md:text-[15px] tracking-widest uppercase font-bold text-red-600";
---

<Base lang={lang} path="/contact" title={t("nav.contact")}>
  <div data-testid="page-contact">
    <!-- HERO -->
    <section class="relative border-b border-gray-200 bg-white">
      <div class="absolute inset-0 gt-grid-bg opacity-50 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
        <div class="max-w-4xl">
          <div class={overline + " mb-6"}>{t("contact.overline")}</div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-[64px] leading-[1.05] tracking-tight font-semibold text-gray-900">
            {t("contact.title")}
          </h1>
          <p class="mt-6 text-lg lg:text-xl text-gray-600 leading-relaxed max-w-3xl">
            {t("contact.body")}
          </p>
        </div>
      </div>
    </section>

    <!-- FORM + CONTACT INFO -->
    <section class="border-b border-gray-200 bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <aside class="lg:col-span-4 order-2 lg:order-1">
            <div class="border border-gray-200 p-8 bg-white">
              <div class={overline + " mb-6"}>{t("contact.reach")}</div>

              <div class="space-y-6">
                <a
                  href={`mailto:${SITE.email}`}
                  data-testid="contact-info-email"
                  class="flex items-start gap-4 group"
                >
                  <div class="w-10 h-10 border border-gray-200 flex items-center justify-center text-red-600 shrink-0">
                    <Mail size={16} />
                  </div>
                  <div>
                    <div class="text-xs md:text-sm tracking-widest text-gray-500 uppercase font-semibold">
                      {t("contact.email")}
                    </div>
                    <div class="mt-1 text-gray-900 group-hover:text-red-600 transition-colors">
                      {SITE.email}
                    </div>
                  </div>
                </a>

                <a
                  href={`tel:${SITE.phoneHref}`}
                  data-testid="contact-info-phone"
                  class="flex items-start gap-4 group"
                >
                  <div class="w-10 h-10 border border-gray-200 flex items-center justify-center text-red-600 shrink-0">
                    <Phone size={16} />
                  </div>
                  <div>
                    <div class="text-xs md:text-sm tracking-widest text-gray-500 uppercase font-semibold">
                      {t("contact.phone")}
                    </div>
                    <div class="mt-1 text-gray-900 group-hover:text-red-600 transition-colors">
                      {SITE.phone}
                    </div>
                  </div>
                </a>

                <div class="flex items-start gap-4" data-testid="contact-info-address">
                  <div class="w-10 h-10 border border-gray-200 flex items-center justify-center text-red-600 shrink-0">
                    <MapPin size={16} />
                  </div>
                  <div>
                    <div class="text-xs md:text-sm tracking-widest text-gray-500 uppercase font-semibold">
                      {t("contact.address")}
                    </div>
                    {/* A U.S. mailing address stays in English in every language. */}
                    <div class="mt-1 text-gray-900" lang="en">{SITE.address}</div>
                  </div>
                </div>

                <div class="flex items-start gap-4" data-testid="contact-info-hours">
                  <div class="w-10 h-10 border border-gray-200 flex items-center justify-center text-red-600 shrink-0">
                    <Clock size={16} />
                  </div>
                  <div>
                    <div class="text-xs md:text-sm tracking-widest text-gray-500 uppercase font-semibold">
                      {t("contact.hours")}
                    </div>
                    <div class="mt-1 text-gray-900">{t("site.hours", { defaultValue: SITE.hours })}</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-6 border border-gray-200 p-7 bg-[#F9FAFB]">
              <div class={overline + " mb-3"}>{t("contact.notQuote.title")}</div>
              <p class="text-[15px] text-gray-700 leading-relaxed">
                {t("contact.notQuote.body")}
              </p>
              <a href={href("/contact-form")} class="btn-secondary mt-5 text-sm">
                {t("contact.notQuote.button")} <ArrowUpRight size={14} />
              </a>
            </div>
          </aside>

          <div class="lg:col-span-8 order-1 lg:order-2">
            <RfqIsland client:load lang={lang} testId="contact-form" />
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
