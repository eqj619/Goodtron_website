---
import { ArrowUpRight, ArrowRight, CircuitBoard, Cpu, Layers, Boxes, Wrench } from "lucide-react";
import Base from "@/layouts/Base.astro";
import QualitySection from "@/components/QualitySection.astro";
import { QUICK_TURN } from "@/lib/site";
import { getI18n, localeStaticPaths, langFromParams } from "@/i18n/core";

export const getStaticPaths = localeStaticPaths;

const lang = langFromParams(Astro.params);
const { t, tl, href } = getI18n(lang);

// Text for each block and machine lives in src/locales/*.json under services.blocks / services.equipment.items.
const SERVICE_BLOCKS = [
  { slug: "smt-assembly", tag: "01", icon: CircuitBoard, img: "/assets/pcb-3.jpg" },
  { slug: "pcb-assembly", tag: "02", icon: Cpu, img: "/assets/pcb-1.jpg" },
  { slug: "prototype-builds", tag: "03", icon: Layers, img: "/assets/about-2.jpg" },
  { slug: "low-volume-production", tag: "04", icon: Boxes, img: "/assets/about-1.jpg" },
  { slug: "through-hole-mixed", tag: "05", icon: Wrench, img: "/assets/about-3.jpg" },
].map((s) => ({
  ...s,
  title: t(`services.blocks.${s.slug}.title`),
  intro: t(`services.blocks.${s.slug}.intro`),
  bullets: tl(`services.blocks.${s.slug}.bullets`),
  imgAlt: t(`services.blocks.${s.slug}.imgAlt`),
}));

const EQUIPMENT = [
  { key: "yamaha-ys12", img: "/assets/facility-1.jpg" },
  { key: "yamaha-ys12f", img: "/assets/facility-ys12f.jpg" },
  { key: "vitronics-soltec-reflow", img: "/assets/facility-reflow.jpg" },
  { key: "inspection-rework", img: "/assets/facility-4.jpg" },
].map((e) => ({
  ...e,
  name: t(`services.equipment.items.${e.key}.name`),
  role: t(`services.equipment.items.${e.key}.role`),
  body: t(`services.equipment.items.${e.key}.body`),
  alt: t(`services.equipment.items.${e.key}.alt`),
}));
---

<Base lang={lang} path="/services" title={t("nav.services")} description={t("services.hero.body")}>
  <div data-testid="page-services">
    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-gray-200 bg-white">
      <div class="absolute inset-0 gt-grid-bg opacity-50 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-28">
        <div class="max-w-4xl">
          <div class="text-sm md:text-base tracking-widest text-black uppercase font-bold mb-6">
            {t("services.hero.overline")}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.05] tracking-tight font-semibold text-black">
            {/* One line: Astro turns line breaks between these into spaces, which breaks CJK. */}
            {t("services.hero.titleBefore")}<span class="text-red-600">{t("services.hero.highlight")}</span>{t("services.hero.titleAfter")}
          </h1>
          <p class="mt-7 text-lg lg:text-xl text-black/80 leading-relaxed max-w-3xl">{t("services.hero.body")}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={href("/quote")} data-testid="services-hero-cta" class="btn-primary">
              {t("quickTurn.cta", { defaultValue: QUICK_TURN.cta })} <ArrowUpRight size={16} />
            </a>
            <a href="#smt-assembly" data-testid="services-hero-jump" class="btn-secondary">
              {t("services.hero.browse")} <ArrowRight size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE OVERVIEW STRIP -->
    <section class="border-b border-gray-200 bg-white" data-testid="services-overview">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 lg:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-px bg-gray-200 border border-gray-200">
          {
            SERVICE_BLOCKS.map((s) => {
              const Icon = s.icon;
              return (
                <a
                  href={`#${s.slug}`}
                  data-testid={`services-overview-${s.slug}`}
                  class="bg-white p-6 flex flex-col gap-3 hover:bg-gray-50 transition-colors"
                >
                  <div class="w-9 h-9 border border-gray-300 flex items-center justify-center text-black">
                    <Icon size={16} />
                  </div>
                  <div class="text-xs tracking-[0.18em] uppercase text-black/70 font-semibold">
                    {t("services.serviceTag", { tag: s.tag })}
                  </div>
                  <div class="text-base font-semibold text-black leading-snug">{s.title}</div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- SERVICE BLOCKS — alternating image/content -->
    {
      SERVICE_BLOCKS.map((s, i) => {
        const reverse = i % 2 === 1;
        const Icon = s.icon;
        return (
          <section
            id={s.slug}
            data-testid={`service-block-${s.slug}`}
            class={`border-b border-gray-200 ${i % 2 === 0 ? "bg-white" : "bg-[#F9FAFB]"} scroll-mt-32`}
          >
            <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 items-center ${reverse ? "lg:[&>*:first-child]:order-2" : ""}`}>
                <div class="lg:col-span-6">
                  <div class="border border-gray-200 overflow-hidden bg-white">
                    <div class="aspect-[4/3] overflow-hidden">
                      <img src={s.img} alt={s.imgAlt} loading="lazy" class="w-full h-full object-cover" />
                    </div>
                  </div>
                </div>
                <div class="lg:col-span-6">
                  <div class="flex items-center gap-4 mb-6">
                    <div class="w-12 h-12 border border-gray-300 bg-white flex items-center justify-center text-black">
                      <Icon size={20} />
                    </div>
                    <div class="text-xs tracking-[0.18em] uppercase text-black/70 font-semibold">
                      {t("services.serviceTagDot", { tag: s.tag })}
                    </div>
                  </div>
                  <h2 class="text-3xl lg:text-4xl tracking-tight font-semibold text-black leading-tight">{s.title}</h2>
                  <p class="mt-5 text-lg text-black/80 leading-relaxed">{s.intro}</p>
                  <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
                    {s.bullets.map((b) => (
                      <li class="flex items-start gap-3 text-[15px] text-black">
                        <span class="text-black mt-0.5">›</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-9">
                    <a
                      href={href("/quote")}
                      data-testid={`service-cta-${s.slug}`}
                      class="inline-flex items-center gap-2 text-sm font-medium text-black border-b border-black pb-1 hover:text-red-600 hover:border-red-600 transition-colors"
                    >
                      {t("services.startQuote", { title: s.title })} <ArrowUpRight size={14} />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </section>
        );
      })
    }

    <QualitySection lang={lang} />

    <!-- EQUIPMENT SECTION — supporting capability, moved to bottom -->
    <section id="equipment" data-testid="section-equipment" class="border-b border-gray-200 bg-[#F5F5F5] scroll-mt-32">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 lg:py-28">
        <div class="max-w-3xl mb-14">
          <div class="text-sm md:text-[15px] tracking-widest text-black uppercase font-bold mb-4">
            {t("services.equipment.overline")}
          </div>
          <h2 class="text-4xl lg:text-5xl tracking-tight font-semibold text-black leading-[1.1]">
            {t("services.equipment.title")}
          </h2>
          <p class="mt-5 text-lg text-black/80 leading-relaxed">{t("services.equipment.body")}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            EQUIPMENT.map((e) => (
              <div data-testid={`equipment-${e.key}`} class="bg-white border border-gray-200 overflow-hidden flex flex-col">
                <div class="aspect-[16/10] overflow-hidden border-b border-gray-200 bg-gray-100">
                  <img src={e.img} alt={e.alt} loading="lazy" class="w-full h-full object-cover" />
                </div>
                <div class="p-7 lg:p-8 flex flex-col flex-1">
                  <div class="text-xs tracking-[0.18em] uppercase text-black/70 font-semibold mb-2">{e.role}</div>
                  <h3 class="text-xl font-semibold text-black">{e.name}</h3>
                  <p class="mt-3 text-[15px] text-black/80 leading-relaxed">{e.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#0A0A0A] text-white relative overflow-hidden">
      <div class="absolute inset-0 gt-grid-bg-dark opacity-40 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-8">
            <div class="text-sm md:text-[15px] tracking-widest text-red-500 uppercase font-bold mb-4">
              {t("services.cta.overline")}
            </div>
            <h2 class="text-3xl lg:text-5xl tracking-tight font-semibold leading-tight">{t("services.cta.title")}</h2>
            <p class="mt-5 text-gray-400 text-lg leading-relaxed max-w-2xl">{t("services.cta.body")}</p>
          </div>
          <div class="lg:col-span-4 lg:text-right">
            <a href={href("/quote")} data-testid="services-bottom-cta" class="btn-primary">
              {t("services.cta.button")} <ArrowUpRight size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
